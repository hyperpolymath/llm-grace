; Independent cross-check of the algebraic laws with Z3 (integers, plus 8-bit machine words for 7).
; For a law that should HOLD we assert its negation: "unsat" = no counterexample exists.
; For a law that should FAIL we assert its negation too: "sat" + model = a counterexample.

(define-fun mx ((a Int) (b Int)) Int (ite (>= a b) a b))
(define-fun absdiff ((a Int) (b Int)) Int (ite (>= a b) (- a b) (- b a)))
(define-fun capadd ((a Int) (b Int)) Int (ite (>= (+ a b) 10) 10 (+ a b)))
(define-fun monus ((a Int) (b Int)) Int (ite (>= a b) (- a b) 0))

(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(assert (>= a 0))
(assert (>= b 0))
(assert (>= c 0))

(echo "2 watermark: max associative (expect unsat)")
(push) (assert (not (= (mx (mx a b) c) (mx a (mx b c))))) (check-sat) (pop)
(echo "2 watermark: 0 neutral both sides (expect unsat)")
(push) (assert (not (and (= (mx 0 a) a) (= (mx a 0) a)))) (check-sat) (pop)
(echo "2 watermark: max commutative (expect unsat)")
(push) (assert (not (= (mx a b) (mx b a)))) (check-sat) (pop)

(echo "3 drift: 0 neutral both sides (expect unsat)")
(push) (assert (not (and (= (absdiff 0 a) a) (= (absdiff a 0) a)))) (check-sat) (pop)
(echo "3 drift: commutative (expect unsat)")
(push) (assert (not (= (absdiff a b) (absdiff b a)))) (check-sat) (pop)
(echo "3 drift: associative (expect sat = counterexample)")
(push) (assert (not (= (absdiff (absdiff a b) c) (absdiff a (absdiff b c)))))
(check-sat) (get-value (a b c (absdiff (absdiff a b) c) (absdiff a (absdiff b c)))) (pop)
(echo "3 drift: the specific instance a=1 b=2 c=3 gives 2 vs 0 (expect unsat)")
(push) (assert (not (and (= (absdiff (absdiff 1 2) 3) 2) (= (absdiff 1 (absdiff 2 3)) 0)))) (check-sat) (pop)

(echo "4 attempts: is there any count m >= 0 with 1 + m = m, i.e. any call site where pure(v) >>= f equals f(v)? (expect unsat)")
(push) (assert (= (+ 1 a) a)) (check-sat) (pop)
(echo "4 attempts: counts add associatively (expect unsat)")
(push) (assert (not (= (+ (+ a b) c) (+ a (+ b c))))) (check-sat) (pop)

(echo "7 backpressure, integers 0..10: associative (expect unsat)")
(push) (assert (<= a 10)) (assert (<= b 10)) (assert (<= c 10))
(assert (not (= (capadd (capadd a b) c) (capadd a (capadd b c))))) (check-sat) (pop)
(echo "7 backpressure: 0 neutral both sides on 0..10 (expect unsat)")
(push) (assert (<= a 10)) (assert (not (and (= (capadd 0 a) a) (= (capadd a 0) a)))) (check-sat) (pop)
(echo "7 backpressure: commutative (expect unsat)")
(push) (assert (not (= (capadd a b) (capadd b a)))) (check-sat) (pop)
(echo "7 backpressure: result stays in 0..10 (expect unsat)")
(push) (assert (not (and (>= (capadd a b) 0) (<= (capadd a b) 10)))) (check-sat) (pop)
(echo "7 backpressure: 0 neutral for an out-of-range value? (expect sat = counterexample)")
(push) (assert (not (= (capadd 0 a) a))) (check-sat) (get-value (a (capadd 0 a))) (pop)

(echo "8 quota: right neutral a - 0 = a (expect unsat)")
(push) (assert (not (= (monus a 0) a))) (check-sat) (pop)
(echo "8 quota: left neutral 0 - a = a (expect sat = counterexample)")
(push) (assert (not (= (monus 0 a) a))) (check-sat) (get-value (a (monus 0 a))) (pop)
(echo "8 quota: associative (expect sat = counterexample)")
(push) (assert (not (= (monus (monus a b) c) (monus a (monus b c)))))
(check-sat) (get-value (a b c (monus (monus a b) c) (monus a (monus b c)))) (pop)
(echo "8 quota: the specific instance a=5 b=3 c=2 gives 0 vs 4 (expect unsat)")
(push) (assert (not (and (= (monus (monus 5 3) 2) 0) (= (monus 5 (monus 3 2)) 4)))) (check-sat) (pop)
(echo "8 quota: action law (q - a) - b = q - (a + b) (expect unsat)")
(push) (assert (not (= (monus (monus a b) c) (monus a (+ b c))))) (check-sat) (pop)

; 8-bit unsigned machine words for component 7: no wrap-around because inputs are <= 10
(define-fun capadd8 ((x (_ BitVec 8)) (y (_ BitVec 8))) (_ BitVec 8)
  (ite (bvuge (bvadd x y) #x0a) #x0a (bvadd x y)))
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(declare-const z (_ BitVec 8))
(echo "7 backpressure, 8-bit unsigned words, inputs <= 10: associative (expect unsat)")
(push) (assert (bvule x #x0a)) (assert (bvule y #x0a)) (assert (bvule z #x0a))
(assert (not (= (capadd8 (capadd8 x y) z) (capadd8 x (capadd8 y z))))) (check-sat) (pop)
