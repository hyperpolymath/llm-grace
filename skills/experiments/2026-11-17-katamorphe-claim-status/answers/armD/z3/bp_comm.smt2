(set-logic QF_LIA)
(define-fun mx ((a Int) (b Int)) Int (ite (>= a b) a b))
(define-fun mn ((a Int) (b Int)) Int (ite (<= a b) a b))
(define-fun ad ((a Int) (b Int)) Int (ite (>= a b) (- a b) (- b a)))
(define-fun cap ((a Int) (b Int)) Int (mn (+ a b) 10))
(define-fun clamp ((x Int)) Int (mx 0 (mn x 10)))
(define-fun monus ((a Int) (b Int)) Int (ite (>= a b) (- a b) 0))
(declare-const a Int)
(declare-const b Int)
(declare-const c Int)
(declare-const d Int)
(declare-const x Int)
(assert (and (<= 0 a 10) (<= 0 b 10) (<= 0 c 10)))
(assert (not (= (cap a b) (cap b a))))
(check-sat)
