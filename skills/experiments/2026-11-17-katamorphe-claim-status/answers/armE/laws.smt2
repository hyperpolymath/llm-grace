; Ledgerline design note: solver pass over the four integer components (2, 3, 7, 8).
; Logic is fixed once (QF_LIA) and never changed. Every query asserts the NEGATION
; of a law, so:  unsat = no counterexample exists (law holds, trusting Z3),
;                sat   = the model printed is a counterexample (re-checked in Agda).
(set-logic QF_LIA)
(set-option :produce-models true)

(define-fun mx   ((a Int) (b Int)) Int (ite (>= a b) a b))                 ; 2 watermark
(define-fun dist ((a Int) (b Int)) Int (ite (>= a b) (- a b) (- b a)))     ; 3 drift
(define-fun cap  ((a Int) (b Int)) Int (ite (>= (+ a b) 10) 10 (+ a b)))   ; 7 backpressure
(define-fun mon  ((a Int) (b Int)) Int (ite (>= a b) (- a b) 0))           ; 8 quota

(declare-const a Int)
(declare-const b Int)
(declare-const c Int)

; ---------- 2 watermark: domain a,b,c >= 0 ----------
(push)
(echo "2 watermark: associativity violated?")
(assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (mx (mx a b) c) (mx a (mx b c)))))
(check-sat)
(pop)
(push)
(echo "2 watermark: identity 0 violated?")
(assert (>= a 0))
(assert (not (and (= (mx 0 a) a) (= (mx a 0) a))))
(check-sat)
(pop)
(push)
(echo "2 watermark: commutativity violated?")
(assert (and (>= a 0) (>= b 0)))
(assert (not (= (mx a b) (mx b a))))
(check-sat)
(pop)

; ---------- 3 drift: domain a,b,c >= 0 ----------
(push)
(echo "3 drift: identity 0 violated?")
(assert (>= a 0))
(assert (not (and (= (dist 0 a) a) (= (dist a 0) a))))
(check-sat)
(pop)
(push)
(echo "3 drift: commutativity violated?")
(assert (and (>= a 0) (>= b 0)))
(assert (not (= (dist a b) (dist b a))))
(check-sat)
(pop)
(push)
(echo "3 drift: associativity violated?")
(assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (dist (dist a b) c) (dist a (dist b c)))))
(check-sat)
(get-value (a b c (dist (dist a b) c) (dist a (dist b c))))
(pop)

; ---------- 7 backpressure: domain 0 <= a,b,c <= 10 ----------
(push)
(echo "7 backpressure: associativity violated?")
(assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10) (>= c 0) (<= c 10)))
(assert (not (= (cap (cap a b) c) (cap a (cap b c)))))
(check-sat)
(pop)
(push)
(echo "7 backpressure: identity 0 violated?")
(assert (and (>= a 0) (<= a 10)))
(assert (not (and (= (cap 0 a) a) (= (cap a 0) a))))
(check-sat)
(pop)
(push)
(echo "7 backpressure: commutativity violated?")
(assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10)))
(assert (not (= (cap a b) (cap b a))))
(check-sat)
(pop)
(push)
(echo "7 backpressure: closure (result leaves 0..10)?")
(assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10)))
(assert (not (and (>= (cap a b) 0) (<= (cap a b) 10))))
(check-sat)
(pop)
(push)
(echo "7 backpressure, side note: associativity violated if negative scores were allowed?")
(assert (and (<= a 10) (<= b 10) (<= c 10)))
(assert (not (= (cap (cap a b) c) (cap a (cap b c)))))
(check-sat)
(get-value (a b c (cap (cap a b) c) (cap a (cap b c))))
(pop)

; ---------- 8 quota: domain a,b,c >= 0 ----------
(push)
(echo "8 quota: right identity (a - 0 = a) violated?")
(assert (>= a 0))
(assert (not (= (mon a 0) a)))
(check-sat)
(pop)
(push)
(echo "8 quota: left identity (0 - a = a) violated?")
(assert (>= a 0))
(assert (not (= (mon 0 a) a)))
(check-sat)
(get-value (a (mon 0 a)))
(pop)
(push)
(echo "8 quota: associativity violated?")
(assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (mon (mon a b) c) (mon a (mon b c)))))
(check-sat)
(get-value (a b c (mon (mon a b) c) (mon a (mon b c))))
(pop)
(push)
(echo "8 quota: commutativity violated?")
(assert (and (>= a 0) (>= b 0)))
(assert (not (= (mon a b) (mon b a))))
(check-sat)
(get-value (a b (mon a b) (mon b a)))
(pop)
(push)
(echo "8 quota: action law (q - a) - b = q - (a + b) violated?")
(assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (mon (mon a b) c) (mon a (+ b c)))))
(check-sat)
(pop)
