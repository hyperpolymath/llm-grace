{-# OPTIONS --safe --without-K #-}

-- Ledgerline ingest pipeline, design note draft 3: machine checks for the eight components.
-- --safe rejects postulates, unsolved holes and unsafe pragmas, so acceptance of this file
-- means every statement below is proved from the definitions in this file alone.
-- No standard library; only the built-in Nat / equality / List.
--
-- Naming: a name ending in "-fails" or starting with "not-" is a proved NEGATIVE result
-- (the law is refuted); every other lemma is a proved law.

module Ledgerline where

open import Agda.Builtin.Nat      using (Nat; zero; suc; _+_)
open import Agda.Builtin.Equality using (_≡_; refl)
open import Agda.Builtin.List     using (List; []; _∷_)

------------------------------------------------------------------------
-- Prelude

data ⊥ : Set where

record ⊤ : Set where
  constructor tt

infix 4 _≢_
_≢_ : {A : Set} → A → A → Set
x ≢ y = x ≡ y → ⊥

sym : {A : Set} {x y : A} → x ≡ y → y ≡ x
sym refl = refl

trans : {A : Set} {x y z : A} → x ≡ y → y ≡ z → x ≡ z
trans refl q = q

cong : {A B : Set} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f refl = refl

cong₂ : {A B C : Set} (f : A → B → C) {x x′ : A} {y y′ : B} → x ≡ x′ → y ≡ y′ → f x y ≡ f x′ y′
cong₂ f refl refl = refl

data Maybe (A : Set) : Set where
  nothing : Maybe A
  just    : A → Maybe A

infixr 4 _,_
record _×_ (A B : Set) : Set where
  constructor _,_
  field
    fst : A
    snd : B
open _×_

infixr 5 _++_
_++_ : {A : Set} → List A → List A → List A
[]       ++ ys = ys
(x ∷ xs) ++ ys = x ∷ (xs ++ ys)

map : {A B : Set} → (A → B) → List A → List B
map f []       = []
map f (x ∷ xs) = f x ∷ map f xs

foldl : {A B : Set} → (B → A → B) → B → List A → B
foldl op acc []       = acc
foldl op acc (x ∷ xs) = foldl op (op acc x) xs

-- arithmetic facts used below
+-idʳ : ∀ n → n + 0 ≡ n
+-idʳ zero    = refl
+-idʳ (suc n) = cong suc (+-idʳ n)

+-suc : ∀ m n → m + suc n ≡ suc (m + n)
+-suc zero    n = refl
+-suc (suc m) n = cong suc (+-suc m n)

+-comm : ∀ m n → m + n ≡ n + m
+-comm zero    n = sym (+-idʳ n)
+-comm (suc m) n = trans (cong suc (+-comm m n)) (sym (+-suc n m))

+-assoc : ∀ a b c → (a + b) + c ≡ a + (b + c)
+-assoc zero    b c = refl
+-assoc (suc a) b c = cong suc (+-assoc a b c)

suc-inj : ∀ {m n} → suc m ≡ suc n → m ≡ n
suc-inj refl = refl

suc≢ : ∀ n → suc n ≢ n
suc≢ zero    ()
suc≢ (suc n) p = suc≢ n (suc-inj p)

------------------------------------------------------------------------
-- Why "monoid" is exactly the licence for "fold in any grouping".
-- Given any associative operation with a two-sided identity:

module Fold {A : Set} (_∙_ : A → A → A) (e : A)
            (idˡ   : ∀ x → e ∙ x ≡ x)
            (idʳ   : ∀ x → x ∙ e ≡ x)
            (assoc : ∀ x y z → (x ∙ y) ∙ z ≡ x ∙ (y ∙ z)) where

  -- the sequential reference fold
  fold : List A → A
  fold []       = e
  fold (x ∷ xs) = x ∙ fold xs

  fold-++ : ∀ xs ys → fold (xs ++ ys) ≡ fold xs ∙ fold ys
  fold-++ []       ys = sym (idˡ (fold ys))
  fold-++ (x ∷ xs) ys = trans (cong (x ∙_) (fold-++ xs ys)) (sym (assoc x (fold xs) (fold ys)))

  -- (a) contiguous shards (empty shards allowed), folded separately, combined in order
  concat : List (List A) → List A
  concat []         = []
  concat (xs ∷ xss) = xs ++ concat xss

  foldShards : List (List A) → A
  foldShards []         = e
  foldShards (xs ∷ xss) = fold xs ∙ foldShards xss

  shard-safe : ∀ xss → foldShards xss ≡ fold (concat xss)
  shard-safe []         = refl
  shard-safe (xs ∷ xss) = trans (cong (fold xs ∙_) (shard-safe xss)) (sym (fold-++ xs (concat xss)))

  -- (b) ANY bracketing that keeps the left-to-right order
  data Tree : Set where
    leaf : A → Tree
    node : Tree → Tree → Tree

  foldT : Tree → A
  foldT (leaf x)   = x
  foldT (node l r) = foldT l ∙ foldT r

  flatten : Tree → List A
  flatten (leaf x)   = x ∷ []
  flatten (node l r) = flatten l ++ flatten r

  grouping-safe : ∀ t → foldT t ≡ fold (flatten t)
  grouping-safe (leaf x)   = sym (idʳ x)
  grouping-safe (node l r) =
    trans (cong₂ _∙_ (grouping-safe l) (grouping-safe r))
          (sym (fold-++ (flatten l) (flatten r)))

  -- (c) with commutativity as well, two shards may also arrive in either order
  module Commutative (comm : ∀ x y → x ∙ y ≡ y ∙ x) where
    swap-safe : ∀ xs ys → fold (xs ++ ys) ≡ fold (ys ++ xs)
    swap-safe xs ys =
      trans (fold-++ xs ys) (trans (comm (fold xs) (fold ys)) (sym (fold-++ ys xs)))

    -- (d) ... and the inputs may be rearranged arbitrarily
    --     (Perm = rearrangements generated by swapping neighbours)
    data Perm : List A → List A → Set where
      done : Perm [] []
      keep : ∀ x {xs ys} → Perm xs ys → Perm (x ∷ xs) (x ∷ ys)
      swap : ∀ x y xs → Perm (x ∷ y ∷ xs) (y ∷ x ∷ xs)
      then : ∀ {xs ys zs} → Perm xs ys → Perm ys zs → Perm xs zs

    reorder-safe : ∀ {xs ys} → Perm xs ys → fold xs ≡ fold ys
    reorder-safe done          = refl
    reorder-safe (keep x p)    = cong (x ∙_) (reorder-safe p)
    reorder-safe (swap x y xs) =
      trans (sym (assoc x y (fold xs)))
            (trans (cong (_∙ fold xs) (comm x y)) (assoc y x (fold xs)))
    reorder-safe (then p q)    = trans (reorder-safe p) (reorder-safe q)

------------------------------------------------------------------------
-- 1. enrich : the Maybe functor

enrich : {A B : Set} → (A → B) → Maybe A → Maybe B
enrich f nothing  = nothing
enrich f (just x) = just (f x)

enrich-id : {A : Set} (m : Maybe A) → enrich (λ x → x) m ≡ m
enrich-id nothing  = refl
enrich-id (just x) = refl

enrich-fuse : {A B C : Set} (f : A → B) (g : B → C) (m : Maybe A)
            → enrich g (enrich f m) ≡ enrich (λ x → g (f x)) m
enrich-fuse f g nothing  = refl
enrich-fuse f g (just x) = refl

-- Hazard model: "absent" is an ordinary value (null) that f itself may return.
-- Then the fusion law is false.
data Val : Set where
  null : Val
  val  : Nat → Val

enrichN : (Val → Val) → Val → Val
enrichN f null    = null
enrichN f (val n) = f (val n)

dropField : Val → Val
dropField _ = null

defaultZero : Val → Val
defaultZero _ = val 0

nullable-fuse-fails :
  enrichN defaultZero (enrichN dropField (val 1)) ≢ enrichN (λ x → defaultZero (dropField x)) (val 1)
nullable-fuse-fails ()

------------------------------------------------------------------------
-- 2. watermark : (Nat, max, 0) is a commutative, idempotent monoid

max : Nat → Nat → Nat
max zero    n       = n
max (suc m) zero    = suc m
max (suc m) (suc n) = suc (max m n)

max-idˡ : ∀ n → max 0 n ≡ n
max-idˡ n = refl

max-idʳ : ∀ n → max n 0 ≡ n
max-idʳ zero    = refl
max-idʳ (suc n) = refl

max-assoc : ∀ a b c → max (max a b) c ≡ max a (max b c)
max-assoc zero    b       c       = refl
max-assoc (suc a) zero    c       = refl
max-assoc (suc a) (suc b) zero    = refl
max-assoc (suc a) (suc b) (suc c) = cong suc (max-assoc a b c)

max-comm : ∀ a b → max a b ≡ max b a
max-comm zero    zero    = refl
max-comm zero    (suc b) = refl
max-comm (suc a) zero    = refl
max-comm (suc a) (suc b) = cong suc (max-comm a b)

max-idem : ∀ a → max a a ≡ a
max-idem zero    = refl
max-idem (suc a) = cong suc (max-idem a)

module Watermark = Fold max 0 max-idˡ max-idʳ max-assoc
module WatermarkC = Watermark.Commutative max-comm

------------------------------------------------------------------------
-- 3. drift : |a - b| has a two-sided identity and is commutative, but is NOT associative

dist : Nat → Nat → Nat
dist zero    n       = n
dist (suc m) zero    = suc m
dist (suc m) (suc n) = dist m n

dist-idˡ : ∀ n → dist 0 n ≡ n
dist-idˡ n = refl

dist-idʳ : ∀ n → dist n 0 ≡ n
dist-idʳ zero    = refl
dist-idʳ (suc n) = refl

dist-comm : ∀ a b → dist a b ≡ dist b a
dist-comm zero    zero    = refl
dist-comm zero    (suc b) = refl
dist-comm (suc a) zero    = refl
dist-comm (suc a) (suc b) = dist-comm a b

dist-assoc-fails : dist (dist 1 2) 3 ≢ dist 1 (dist 2 3)      -- 2 versus 0
dist-assoc-fails ()

-- the same failure at the level of the planned fold: readings 1, 2, 3
drift-sequential : foldl dist 0 (1 ∷ 2 ∷ 3 ∷ []) ≡ 2
drift-sequential = refl

drift-two-shards : dist (foldl dist 0 (1 ∷ [])) (foldl dist 0 (2 ∷ 3 ∷ [])) ≡ 0
drift-two-shards = refl

------------------------------------------------------------------------
-- 4. attempts : pairs (value, count); bind adds counts

Att : Set → Set
Att A = A × Nat

infixl 1 _>>=_
_>>=_ : {A B : Set} → Att A → (A → Att B) → Att B
m >>= f = fst (f (fst m)) , (snd m + snd (f (fst m)))

-- the design note's unit
pure₁ : {A : Set} → A → Att A
pure₁ v = v , 1

-- left identity fails for EVERY step and EVERY value: the rewrite always loses one attempt
left-identity-fails : {A B : Set} (f : A → Att B) (v : A) → (pure₁ v >>= f) ≢ f v
left-identity-fails f v p = suc≢ (snd (f v)) (cong snd p)

-- right identity fails for every m
right-identity-fails : {A : Set} (m : Att A) → (m >>= pure₁) ≢ m
right-identity-fails m p = suc≢ (snd m) (trans (sym (+1 (snd m))) (cong snd p))
  where
  +1 : ∀ n → n + 1 ≡ suc n
  +1 n = trans (+-suc n 0) (cong suc (+-idʳ n))

-- bind itself is associative (this law does hold)
bind-assoc : {A B C : Set} (m : Att A) (f : A → Att B) (g : B → Att C)
           → ((m >>= f) >>= g) ≡ (m >>= (λ x → f x >>= g))
bind-assoc m f g =
  cong (fst (g (fst (f (fst m)))) ,_)
       (+-assoc (snd m) (snd (f (fst m))) (snd (g (fst (f (fst m))))))

-- a concrete instance of the planned rewrite `pure(v) >>= f  ~>  f(v)`
step : Nat → Att Nat
step v = suc v , 1

rewrite-before : (pure₁ 7 >>= step) ≡ (8 , 2)
rewrite-before = refl

rewrite-after : step 7 ≡ (8 , 1)
rewrite-after = refl

-- the value-only map IS a functor
mapAtt : {A B : Set} → (A → B) → Att A → Att B
mapAtt f m = f (fst m) , snd m

mapAtt-id : {A : Set} (m : Att A) → mapAtt (λ x → x) m ≡ m
mapAtt-id m = refl

mapAtt-fuse : {A B C : Set} (f : A → B) (g : B → C) (m : Att A)
            → mapAtt g (mapAtt f m) ≡ mapAtt (λ x → g (f x)) m
mapAtt-fuse f g m = refl

-- the repair: unit with count 0 (the writer monad over (Nat, +, 0)); counting is a separate effect
pure₀ : {A : Set} → A → Att A
pure₀ v = v , 0

tick : {A : Set} → A → Att A       -- "producing this value cost one attempt"
tick v = v , 1

fixed-left-identity : {A B : Set} (f : A → Att B) (v : A) → (pure₀ v >>= f) ≡ f v
fixed-left-identity f v = refl

fixed-right-identity : {A : Set} (m : Att A) → (m >>= pure₀) ≡ m
fixed-right-identity m = cong (fst m ,_) (+-idʳ (snd m))

------------------------------------------------------------------------
-- 5. overlay : "last present wins" is a monoid, not commutative

overlay : {A : Set} → Maybe A → Maybe A → Maybe A      -- overlay earlier later
overlay e nothing  = e
overlay e (just x) = just x

overlay-idˡ : {A : Set} (l : Maybe A) → overlay nothing l ≡ l
overlay-idˡ nothing  = refl
overlay-idˡ (just x) = refl

overlay-idʳ : {A : Set} (e : Maybe A) → overlay e nothing ≡ e
overlay-idʳ e = refl

overlay-assoc : {A : Set} (a b c : Maybe A) → overlay (overlay a b) c ≡ overlay a (overlay b c)
overlay-assoc a b nothing  = refl
overlay-assoc a b (just x) = refl

overlay-comm-fails : overlay (just 1) (just 2) ≢ overlay (just 2) (just 1)
overlay-comm-fails ()

module Overlay {A : Set} = Fold (overlay {A}) nothing overlay-idˡ overlay-idʳ overlay-assoc

------------------------------------------------------------------------
-- 6. transformBatch : map followed by reverse is NOT a functor

reverse : {A : Set} → List A → List A
reverse []       = []
reverse (x ∷ xs) = reverse xs ++ (x ∷ [])

transformBatch : {A B : Set} → (A → B) → List A → List B
transformBatch f xs = reverse (map f xs)

tb-identity-fails : transformBatch (λ x → x) (1 ∷ 2 ∷ []) ≢ (1 ∷ 2 ∷ [])
tb-identity-fails ()

-- planned fusion, on the batch [1, 2] with f = g = suc: [3, 4] versus [4, 3]
tb-fuse-fails :
  transformBatch suc (transformBatch suc (1 ∷ 2 ∷ [])) ≢ transformBatch (λ x → suc (suc x)) (1 ∷ 2 ∷ [])
tb-fuse-fails ()

-- what two consecutive calls really compute: a plain map, original order
map-++ : {A B : Set} (f : A → B) (xs ys : List A) → map f (xs ++ ys) ≡ map f xs ++ map f ys
map-++ f []       ys = refl
map-++ f (x ∷ xs) ys = cong (f x ∷_) (map-++ f xs ys)

map-reverse : {A B : Set} (f : A → B) (xs : List A) → map f (reverse xs) ≡ reverse (map f xs)
map-reverse f []       = refl
map-reverse f (x ∷ xs) =
  trans (map-++ f (reverse xs) (x ∷ [])) (cong (_++ (f x ∷ [])) (map-reverse f xs))

reverse-snoc : {A : Set} (xs : List A) (x : A) → reverse (xs ++ (x ∷ [])) ≡ x ∷ reverse xs
reverse-snoc []       x = refl
reverse-snoc (y ∷ xs) x = cong (_++ (y ∷ [])) (reverse-snoc xs x)

reverse-reverse : {A : Set} (xs : List A) → reverse (reverse xs) ≡ xs
reverse-reverse []       = refl
reverse-reverse (x ∷ xs) = trans (reverse-snoc (reverse xs) x) (cong (x ∷_) (reverse-reverse xs))

map-fuse : {A B C : Set} (f : A → B) (g : B → C) (xs : List A)
         → map g (map f xs) ≡ map (λ x → g (f x)) xs
map-fuse f g []       = refl
map-fuse f g (x ∷ xs) = cong (g (f x) ∷_) (map-fuse f g xs)

map-id : {A : Set} (xs : List A) → map (λ x → x) xs ≡ xs
map-id []       = refl
map-id (x ∷ xs) = cong (x ∷_) (map-id xs)

tb-twice : {A B C : Set} (f : A → B) (g : B → C) (xs : List A)
         → transformBatch g (transformBatch f xs) ≡ map (λ x → g (f x)) xs
tb-twice f g xs =
  trans (cong reverse (map-reverse g (map f xs)))
        (trans (reverse-reverse (map g (map f xs))) (map-fuse f g xs))

-- the correct fusion rule: fused call plus one more reverse
tb-fuse-correct : {A B C : Set} (f : A → B) (g : B → C) (xs : List A)
                → transformBatch g (transformBatch f xs) ≡ reverse (transformBatch (λ x → g (f x)) xs)
tb-fuse-correct f g xs =
  trans (tb-twice f g xs) (sym (reverse-reverse (map (λ x → g (f x)) xs)))

------------------------------------------------------------------------
-- 7. backpressure : addition capped at 10 on scores 0..10 is a commutative monoid

min : Nat → Nat → Nat
min zero    n       = zero
min (suc m) zero    = zero
min (suc m) (suc n) = suc (min m n)

min-0ʳ : ∀ m → min m 0 ≡ 0
min-0ʳ zero    = refl
min-0ʳ (suc m) = refl

-- capping an intermediate sum does not change the capped total (any cap n)
cap-left : ∀ x c n → min (min x n + c) n ≡ min (x + c) n
cap-left zero    c n       = refl
cap-left (suc x) c zero    = min-0ʳ c
cap-left (suc x) c (suc n) = cong suc (cap-left x c n)

cap-right : ∀ a y n → min (a + min y n) n ≡ min (a + y) n
cap-right a y n =
  trans (cong (λ k → min k n) (+-comm a (min y n)))
        (trans (cap-left y a n) (cong (λ k → min k n) (+-comm y a)))

cap-assoc : ∀ n a b c → min (min (a + b) n + c) n ≡ min (a + min (b + c) n) n
cap-assoc n a b c =
  trans (cap-left (a + b) c n)
        (trans (cong (λ k → min k n) (+-assoc a b c)) (sym (cap-right a (b + c) n)))

-- the carrier really is 0..10: a number together with evidence that it is at most 10
data Bool : Set where
  false true : Bool

T : Bool → Set
T true  = ⊤
T false = ⊥

_≤ᵇ_ : Nat → Nat → Bool
zero  ≤ᵇ n     = true
suc m ≤ᵇ zero  = false
suc m ≤ᵇ suc n = m ≤ᵇ n

infix 4 _≤_
_≤_ : Nat → Nat → Set
m ≤ n = T (m ≤ᵇ n)

≤-irrelevant : ∀ m n (p q : m ≤ n) → p ≡ q
≤-irrelevant zero    n       p q = refl
≤-irrelevant (suc m) zero    () q
≤-irrelevant (suc m) (suc n) p q = ≤-irrelevant m n p q

min-≤ : ∀ x n → min x n ≤ n
min-≤ zero    n       = tt
min-≤ (suc x) zero    = tt
min-≤ (suc x) (suc n) = min-≤ x n

min-id : ∀ a n → a ≤ n → min a n ≡ a
min-id zero    n       p = refl
min-id (suc a) zero    ()
min-id (suc a) (suc n) p = cong suc (min-id a n p)

record Score : Set where
  constructor score
  field
    points  : Nat
    inRange : points ≤ 10

score-≡ : ∀ {a b} {p : a ≤ 10} {q : b ≤ 10} → a ≡ b → score a p ≡ score b q
score-≡ {a} {p = p} {q = q} refl = cong (score a) (≤-irrelevant a 10 p q)

infixl 6 _⊕_
_⊕_ : Score → Score → Score
score a _ ⊕ score b _ = score (min (a + b) 10) (min-≤ (a + b) 10)

noPressure : Score
noPressure = score 0 tt

⊕-idˡ : ∀ s → noPressure ⊕ s ≡ s
⊕-idˡ (score a p) = score-≡ (min-id a 10 p)

⊕-idʳ : ∀ s → s ⊕ noPressure ≡ s
⊕-idʳ (score a p) = score-≡ (trans (cong (λ k → min k 10) (+-idʳ a)) (min-id a 10 p))

⊕-assoc : ∀ r s t → (r ⊕ s) ⊕ t ≡ r ⊕ (s ⊕ t)
⊕-assoc (score a _) (score b _) (score c _) = score-≡ (cap-assoc 10 a b c)

⊕-comm : ∀ r s → r ⊕ s ≡ s ⊕ r
⊕-comm (score a _) (score b _) = score-≡ (cong (λ k → min k 10) (+-comm a b))

module Backpressure = Fold _⊕_ noPressure ⊕-idˡ ⊕-idʳ ⊕-assoc
module BackpressureC = Backpressure.Commutative ⊕-comm

------------------------------------------------------------------------
-- 8. quota : truncated subtraction is NOT a monoid; it is an ACTION of (Nat, +, 0)

infixl 6 _∸_
_∸_ : Nat → Nat → Nat
n     ∸ zero  = n
zero  ∸ suc m = zero
suc n ∸ suc m = n ∸ m

∸-idʳ : ∀ a → a ∸ 0 ≡ a
∸-idʳ a = refl

0∸ : ∀ a → 0 ∸ a ≡ 0
0∸ zero    = refl
0∸ (suc a) = refl

-- 0 is not a left identity: 0 ∸ a is 0, never a positive a
∸-left-identity-fails : ∀ a → 0 ∸ suc a ≢ suc a
∸-left-identity-fails a ()

∸-assoc-fails : (5 ∸ 3) ∸ 1 ≢ 5 ∸ (3 ∸ 1)                     -- 1 versus 3
∸-assoc-fails ()

∸-comm-fails : 5 ∸ 3 ≢ 3 ∸ 5                                   -- 2 versus 0
∸-comm-fails ()

-- the planned fold over the events 5, 3, 1 gives three different answers
quota-foldl-from-0 : foldl _∸_ 0 (5 ∷ 3 ∷ 1 ∷ []) ≡ 0
quota-foldl-from-0 = refl

quota-left-grouping : (5 ∸ 3) ∸ 1 ≡ 1
quota-left-grouping = refl

quota-right-grouping : 5 ∸ (3 ∸ 1) ≡ 3
quota-right-grouping = refl

-- a left fold seeded with the "neutral" 0 is constantly 0
quota-foldl-0-constant : ∀ xs → foldl _∸_ 0 xs ≡ 0
quota-foldl-0-constant []       = refl
quota-foldl-0-constant (x ∷ xs) = trans (cong (λ k → foldl _∸_ k xs) (0∸ x)) (quota-foldl-0-constant xs)

-- what does hold: successive deductions equal one deduction of the sum
∸-action : ∀ q a b → (q ∸ a) ∸ b ≡ q ∸ (a + b)
∸-action q       zero    b = refl
∸-action zero    (suc a) b = 0∸ b
∸-action (suc q) (suc a) b = ∸-action q a b

-- hence: deducting a whole list one by one = deducting its (parallelisable) sum once
sum : List Nat → Nat
sum []       = 0
sum (x ∷ xs) = x + sum xs

quota-safe-form : ∀ q xs → foldl _∸_ q xs ≡ q ∸ sum xs
quota-safe-form q []       = refl
quota-safe-form q (x ∷ xs) = trans (quota-safe-form (q ∸ x) xs) (∸-action q x (sum xs))

+-idˡ : ∀ n → 0 + n ≡ n
+-idˡ n = refl

module QuotaSum = Fold _+_ 0 +-idˡ +-idʳ +-assoc
module QuotaSumC = QuotaSum.Commutative +-comm
