; Each block asserts the NEGATION of a law. unsat = the law holds; sat = counterexample.
(define-fun mx ((a Int) (b Int)) Int (ite (>= a b) a b))
(define-fun dist ((a Int) (b Int)) Int (ite (>= a b) (- a b) (- b a)))
(define-fun cap ((a Int) (b Int)) Int (ite (>= (+ a b) 10) 10 (+ a b)))
(define-fun monus ((a Int) (b Int)) Int (ite (>= a b) (- a b) 0))
(declare-const a Int) (declare-const b Int) (declare-const c Int)

(echo "2 watermark: max associative on naturals (expect unsat)")
(push) (assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (mx (mx a b) c) (mx a (mx b c))))) (check-sat) (pop)
(echo "2 watermark: 0 is two-sided unit on naturals (expect unsat)")
(push) (assert (>= a 0)) (assert (not (and (= (mx 0 a) a) (= (mx a 0) a)))) (check-sat) (pop)
(echo "2 watermark: 0 is NOT a unit if marks may be negative (expect sat)")
(push) (assert (not (and (= (mx 0 a) a) (= (mx a 0) a)))) (check-sat) (get-model) (pop)

(echo "3 drift: 0 is two-sided unit (expect unsat)")
(push) (assert (>= a 0)) (assert (not (and (= (dist 0 a) a) (= (dist a 0) a)))) (check-sat) (pop)
(echo "3 drift: commutative (expect unsat)")
(push) (assert (and (>= a 0) (>= b 0))) (assert (not (= (dist a b) (dist b a)))) (check-sat) (pop)
(echo "3 drift: associative (expect sat = counterexample)")
(push) (assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (dist (dist a b) c) (dist a (dist b c))))) (check-sat) (get-model) (pop)

(echo "7 backpressure: closed on 0..10 (expect unsat)")
(push) (assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10)))
(assert (not (and (>= (cap a b) 0) (<= (cap a b) 10)))) (check-sat) (pop)
(echo "7 backpressure: associative on 0..10 (expect unsat)")
(push) (assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10) (>= c 0) (<= c 10)))
(assert (not (= (cap (cap a b) c) (cap a (cap b c))))) (check-sat) (pop)
(echo "7 backpressure: 0 is two-sided unit on 0..10 (expect unsat)")
(push) (assert (and (>= a 0) (<= a 10)))
(assert (not (and (= (cap 0 a) a) (= (cap a 0) a)))) (check-sat) (pop)
(echo "7 backpressure: commutative (expect unsat)")
(push) (assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10)))
(assert (not (= (cap a b) (cap b a)))) (check-sat) (pop)
(echo "7 backpressure: capped fold equals cap of the exact sum (expect unsat)")
(push) (assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10) (>= c 0) (<= c 10)))
(assert (not (= (cap (cap a b) c) (ite (>= (+ a b c) 10) 10 (+ a b c))))) (check-sat) (pop)
(echo "7 backpressure: associativity if negative deltas are allowed (expect sat)")
(push) (assert (and (>= a -10) (<= a 10) (>= b -10) (<= b 10) (>= c -10) (<= c 10)))
(assert (not (= (cap (cap a b) c) (cap a (cap b c))))) (check-sat) (get-model) (pop)

(echo "8 quota: right unit a - 0 = a (expect unsat)")
(push) (assert (>= a 0)) (assert (not (= (monus a 0) a))) (check-sat) (pop)
(echo "8 quota: left unit 0 - a = a (expect sat)")
(push) (assert (>= a 0)) (assert (not (= (monus 0 a) a))) (check-sat) (get-model) (pop)
(echo "8 quota: associative (expect sat)")
(push) (assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (monus (monus a b) c) (monus a (monus b c))))) (check-sat) (get-model) (pop)
(echo "8 quota: commutative (expect sat)")
(push) (assert (and (>= a 0) (>= b 0))) (assert (not (= (monus a b) (monus b a)))) (check-sat) (pop)
(echo "8 quota: action law (q - a) - b = q - (a + b) (expect unsat)")
(push) (assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (monus (monus a b) c) (monus a (+ b c))))) (check-sat) (pop)
