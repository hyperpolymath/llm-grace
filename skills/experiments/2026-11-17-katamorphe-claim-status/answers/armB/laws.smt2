; Each block asserts the NEGATION of a law.
; unsat = the law holds for all values in the domain; sat = counterexample (model printed).
(set-option :produce-models true)

(define-fun mx ((a Int) (b Int)) Int (ite (>= a b) a b))
(define-fun absd ((a Int) (b Int)) Int (ite (>= a b) (- a b) (- b a)))
(define-fun cap ((a Int) (b Int)) Int (ite (>= (+ a b) 10) 10 (+ a b)))
(define-fun monus ((a Int) (b Int)) Int (ite (>= a b) (- a b) 0))

(declare-const a Int)
(declare-const b Int)
(declare-const c Int)

; ---------- 2. watermark: (N, max, 0)
(echo "2 watermark: left unit")
(push) (assert (>= a 0)) (assert (not (= (mx 0 a) a))) (check-sat) (pop)
(echo "2 watermark: right unit")
(push) (assert (>= a 0)) (assert (not (= (mx a 0) a))) (check-sat) (pop)
(echo "2 watermark: associativity")
(push) (assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (mx (mx a b) c) (mx a (mx b c))))) (check-sat) (pop)
(echo "2 watermark: commutativity")
(push) (assert (and (>= a 0) (>= b 0))) (assert (not (= (mx a b) (mx b a)))) (check-sat) (pop)
(echo "2 watermark: idempotence")
(push) (assert (>= a 0)) (assert (not (= (mx a a) a))) (check-sat) (pop)

; ---------- 3. drift: (N, |a-b|, 0)
(echo "3 drift: left unit")
(push) (assert (>= a 0)) (assert (not (= (absd 0 a) a))) (check-sat) (pop)
(echo "3 drift: right unit")
(push) (assert (>= a 0)) (assert (not (= (absd a 0) a))) (check-sat) (pop)
(echo "3 drift: commutativity")
(push) (assert (and (>= a 0) (>= b 0))) (assert (not (= (absd a b) (absd b a)))) (check-sat) (pop)
(echo "3 drift: associativity")
(push) (assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (absd (absd a b) c) (absd a (absd b c))))) (check-sat) (get-value (a b c (absd (absd a b) c) (absd a (absd b c)))) (pop)

; ---------- 7. backpressure: ({0..10}, capped +, 0)
(echo "7 backpressure: closure in 0..10")
(push) (assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10)))
(assert (not (and (>= (cap a b) 0) (<= (cap a b) 10)))) (check-sat) (pop)
(echo "7 backpressure: left unit")
(push) (assert (and (>= a 0) (<= a 10))) (assert (not (= (cap 0 a) a))) (check-sat) (pop)
(echo "7 backpressure: right unit")
(push) (assert (and (>= a 0) (<= a 10))) (assert (not (= (cap a 0) a))) (check-sat) (pop)
(echo "7 backpressure: associativity")
(push) (assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10) (>= c 0) (<= c 10)))
(assert (not (= (cap (cap a b) c) (cap a (cap b c))))) (check-sat) (pop)
(echo "7 backpressure: commutativity")
(push) (assert (and (>= a 0) (<= a 10) (>= b 0) (<= b 10)))
(assert (not (= (cap a b) (cap b a)))) (check-sat) (pop)
(echo "7 backpressure: idempotence (expected to fail)")
(push) (assert (and (>= a 0) (<= a 10))) (assert (not (= (cap a a) a))) (check-sat) (get-value (a (cap a a))) (pop)
(echo "7 backpressure: capping is a homomorphism from (N,+): cap(sat a, sat b) = sat(a+b)")
(push) (assert (and (>= a 0) (>= b 0)))
(assert (not (= (cap (ite (>= a 10) 10 a) (ite (>= b 10) 10 b)) (ite (>= (+ a b) 10) 10 (+ a b))))) (check-sat) (pop)
(echo "7 backpressure: associativity if negative scores were ever admitted (outside the stated domain)")
(push) (assert (and (<= a 10) (<= b 10) (<= c 10) (>= a -10) (>= b -10) (>= c -10)))
(assert (not (= (cap (cap a b) c) (cap a (cap b c))))) (check-sat) (get-value (a b c (cap (cap a b) c) (cap a (cap b c)))) (pop)

; ---------- 8. quota: (N, monus, 0)
(echo "8 quota: right unit  a - 0 = a")
(push) (assert (>= a 0)) (assert (not (= (monus a 0) a))) (check-sat) (pop)
(echo "8 quota: left unit  0 - a = a")
(push) (assert (>= a 0)) (assert (not (= (monus 0 a) a))) (check-sat) (get-value (a (monus 0 a))) (pop)
(echo "8 quota: associativity")
(push) (assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (monus (monus a b) c) (monus a (monus b c))))) (check-sat) (get-value (a b c (monus (monus a b) c) (monus a (monus b c)))) (pop)
(echo "8 quota: commutativity")
(push) (assert (and (>= a 0) (>= b 0))) (assert (not (= (monus a b) (monus b a)))) (check-sat) (get-value (a b (monus a b) (monus b a))) (pop)
(echo "8 quota: right action of (N,+):  (q - a) - b = q - (a + b)")
(push) (assert (and (>= a 0) (>= b 0) (>= c 0)))
(assert (not (= (monus (monus a b) c) (monus a (+ b c))))) (check-sat) (pop)

; ---------- 8b. quota with mixed consume/release events:
; an event is the function x |-> max(x + d, l) on x >= 0, with l >= max(d, 0).
; consume n = (-n, 0), release n = (n, n). Composition "first (d1,l1) then (d2,l2)" = (d1+d2, max(l1+d2, l2)).
(declare-const d1 Int) (declare-const l1 Int)
(declare-const d2 Int) (declare-const l2 Int)
(declare-const d3 Int) (declare-const l3 Int)
(declare-const x Int)
(define-fun ok ((d Int) (l Int)) Bool (and (>= l d) (>= l 0)))
(define-fun app ((d Int) (l Int) (y Int)) Int (mx (+ y d) l))
(echo "8b clamp: composition formula agrees with running the two events in sequence")
(push) (assert (and (ok d1 l1) (ok d2 l2) (>= x 0)))
(assert (not (= (app d2 l2 (app d1 l1 x)) (app (+ d1 d2) (mx (+ l1 d2) l2) x)))) (check-sat) (pop)
(echo "8b clamp: closure")
(push) (assert (and (ok d1 l1) (ok d2 l2)))
(assert (not (ok (+ d1 d2) (mx (+ l1 d2) l2)))) (check-sat) (pop)
(echo "8b clamp: unit (0,0) left and right")
(push) (assert (ok d1 l1))
(assert (not (and (= (mx (+ 0 d1) l1) l1) (= (mx (+ l1 0) 0) l1)))) (check-sat) (pop)
(echo "8b clamp: associativity of the second component")
(push) (assert (and (ok d1 l1) (ok d2 l2) (ok d3 l3)))
(assert (not (= (mx (+ (mx (+ l1 d2) l2) d3) l3) (mx (+ l1 (+ d2 d3)) (mx (+ l2 d3) l3))))) (check-sat) (pop)
(echo "8b clamp: consume n is (-n,0) and release n is (n,n)")
(push) (assert (and (>= x 0) (>= a 0)))
(assert (not (and (= (app (- a) 0 x) (monus x a)) (= (app a a x) (+ x a))))) (check-sat) (pop)
(echo "8b clamp: commutativity (expected to fail: order must be kept)")
(push) (assert (and (ok d1 l1) (ok d2 l2)))
(assert (not (= (mx (+ l1 d2) l2) (mx (+ l2 d1) l1)))) (check-sat) (get-value (d1 l1 d2 l2)) (pop)

; ---------- 3b. drift repaired: spread = max - min, carried as a (lo, hi) pair with an adjoined empty element
; modelled here on non-empty summaries only: (lo,hi) . (lo',hi') = (min lo lo', max hi hi')
(define-fun mn ((p Int) (q Int)) Int (ite (<= p q) p q))
(echo "3b spread: min associativity / max associativity (component-wise)")
(push) (assert (not (and (= (mn (mn a b) c) (mn a (mn b c))) (= (mx (mx a b) c) (mx a (mx b c)))))) (check-sat) (pop)

; ---------- 4. attempts: T v = (v, n), pure v = (v, 1), (v, n) >>= f = (fst (f v), n + snd (f v))
(declare-sort V 0)
(declare-datatypes ((P 0)) (((mk (val V) (cnt Int)))))
(declare-fun f (V) P)
(declare-fun g (V) P)
(declare-const v V)
(declare-const m P)
(define-fun bindf ((p P)) P (mk (val (f (val p))) (+ (cnt p) (cnt (f (val p))))))
(define-fun bindg ((p P)) P (mk (val (g (val p))) (+ (cnt p) (cnt (g (val p))))))
(define-fun pure1 ((w V)) P (mk w 1))
(define-fun pure0 ((w V)) P (mk w 0))
(echo "4 attempts: left identity  pure v >>= f = f v   (pure v = (v,1))")
(push) (assert (not (= (bindf (pure1 v)) (f v)))) (check-sat) (pop)
(echo "4 attempts: is left identity EVER true with pure v = (v,1)? (unsat = never)")
(push) (assert (= (bindf (pure1 v)) (f v))) (check-sat) (pop)
(echo "4 attempts: right identity  m >>= pure = m   (pure v = (v,1))")
(push) (assert (not (= (mk (val m) (+ (cnt m) 1)) m))) (check-sat) (pop)
(echo "4 attempts: is right identity EVER true with pure v = (v,1)? (unsat = never)")
(push) (assert (= (mk (val m) (+ (cnt m) 1)) m)) (check-sat) (pop)
(echo "4 attempts: associativity  (m >>= f) >>= g = m >>= (\\x. f x >>= g)")
(push) (assert (not (= (bindg (bindf m))
   (mk (val (bindg (f (val m)))) (+ (cnt m) (cnt (bindg (f (val m))))))))) (check-sat) (pop)
(echo "4 attempts repaired: left identity with pure v = (v,0)")
(push) (assert (not (= (bindf (pure0 v)) (f v)))) (check-sat) (pop)
(echo "4 attempts repaired: right identity with pure v = (v,0)")
(push) (assert (not (= (mk (val m) (+ (cnt m) 0)) m))) (check-sat) (pop)
